{
  "name": "@cecnic1989/homebridge-frigidaire-dehumidifier",
  "displayName": "Frigidaire Dehumidifier",
  "type": "module",
  "version": "0.6.0",
  "description": "Homebridge plugin for Frigidaire/Electrolux dehumidifiers via the Electrolux OCP API",
  "author": "",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cecnic1989/homebridge-frigidaire-dehumidifier#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/cecnic1989/homebridge-frigidaire-dehumidifier.git"
  },
  "bugs": {
    "url": "https://github.com/cecnic1989/homebridge-frigidaire-dehumidifier/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/cecnic1989"
  },
  "keywords": [
    "homebridge-plugin",
    "frigidaire",
    "electrolux",
    "dehumidifier",
    "homekit"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.19.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test test/checker.test.ts test/mappers.test.ts",
    "test:e2e:api": "tsx e2e/api.e2e.ts",
    "test:e2e:command": "tsx e2e/command.e2e.ts",
    "test:e2e:notifications": "tsx --env-file=.env e2e/notifications.e2e.ts",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.2.0",
    "homebridge": "^2.0.0-beta.55",
    "homebridge-config-ui-x": "^5.22.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "axios": "^1.18.1",
    "fastify": "^5.8.5",
    "ws": "^8.21.0"
  }
}
